+// Convert one 32-bit I2S slot (24-bit INMP441 data, MSB-aligned) to int16 with gain.
+static inline int16_t slot_to_s16(int32_t raw)
+{
+    int32_t s = (raw >> MIC_BIT_SHIFT) * MIC_GAIN;
+    if (s > 32767)
+        s = 32767;
+    if (s < -32768)
+        s = -32768;
+    return (int16_t) s;
+}
